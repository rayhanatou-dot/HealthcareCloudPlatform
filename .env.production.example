APP_NAME=Healthcare Cloud Platform
APP_ENV=production
APP_DEBUG=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

POSTGRES_USER=healthcare_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=healthcare_cloud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthcare_prod_user:REPLACE_WITH_SECURE_POSTGRES_PASSWORD@postgres:5432/healthcare_cloud_db

JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=healthcare_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_SECURE_MINIO_PASSWORD
MINIO_BUCKET_NAME=healthcare-files
MINIO_SECURE=false

DOCS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend,healthcare_prod_backend
