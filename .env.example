
```env
# Application Settings
APP_NAME=Healthcare Cloud Platform
APP_ENV=development
APP_DEBUG=true

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Settings
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=healthcare_cloud_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@postgres:5432/healthcare_cloud_db

# JWT Security
JWT_SECRET_KEY=replace_with_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MinIO Object Storage
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=healthcare-files

# MinIO Console
MINIO_CONSOLE_PORT=9001

# Testing Settings
TEST_DATABASE_URL=postgresql://test_user:test_password@postgres:5432/test_healthcare_cloud_db